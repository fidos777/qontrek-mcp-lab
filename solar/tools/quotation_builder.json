  },
  "downstream_dependency": {
    "tool": null,
    "description": "Quotation builder is the final step in the solar sales workflow. Generated quotations are sent to customers and tracked for acceptance. No downstream MCP tools are invoked, but webhooks notify external systems on quote events.",
    "external_integrations": [
      {
        "name": "Qontrek Document Factory",
        "type": "api",
        "description": "Document generation service for PDF/DOCX/PPTX output"
      },
      {
        "name": "Email/WhatsApp Service",
        "type": "webhook",
        "description": "Notification service for quote delivery"
      }
    ]
  },
  "dependencies": {
    "upstream": ["roi_calculator"],
    "downstream": [],
    "external": [
      {
        "name": "Qontrek Document Factory",
        "type": "api",
        "description": "Document generation service for PDF/DOCX/PPTX output"
      }
    ]
  },
  "execution": {
    "timeout_ms": 30000,
    "retry_policy": {
      "max_retries": 3,
      "backoff_ms": 2000
    },
    "idempotent": false,
    "async_supported": true
  },
  "validation": {
    "strict_mode": true,
    "coerce_types": true
  },
  "permissions": {
    "required_scopes": ["solar:quotation:write", "solar:roi:read", "documents:generate"],
    "rate_limit": {
      "requests_per_minute": 20,
      "requests_per_day": 200
    }
  },
  "templates": {
    "available": [
      {
        "id": "standard",
        "name": "Standard Template",
        "description": "Clean, professional template for most use cases"
      },
      {
        "id": "premium",
        "name": "Premium Template",
        "description": "High-end design for luxury residential projects"
      },
      {
        "id": "commercial",
        "name": "Commercial Template",
        "description": "Detailed template for commercial/industrial projects"
      },
      {
        "id": "minimal",
        "name": "Minimal Template",
        "description": "Simple one-page summary quote"
      }
    ]
  },
  "webhooks": {
    "on_quote_generated": {
      "enabled": true,
      "url_template": "{{WEBHOOK_BASE_URL}}/quotes/generated",
      "description": "Triggered when quote generation is complete"
    },
    "on_quote_viewed": {
      "enabled": true,
      "url_template": "{{WEBHOOK_BASE_URL}}/quotes/viewed",
      "description": "Triggered when customer views the quote"
    },
    "on_quote_accepted": {
      "enabled": true,
      "url_template": "{{WEBHOOK_BASE_URL}}/quotes/accepted",
      "description": "Triggered when customer accepts the quote"
    }
  },
  "metadata": {
    "author": "Qontrek MCP Lab",
    "created_at": "2025-12-05",
    "updated_at": "2025-12-05",
    "documentation_url": "https://docs.qontrek.com/solar/tools/quotation_builder"
  }
}
