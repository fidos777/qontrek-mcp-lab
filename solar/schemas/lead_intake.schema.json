{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Solar Lead Intake Schema",
  "description": "Schema for solar lead intake and customer information",
  "required": [
    "customer_name",
    "email",
    "phone",
    "address",
    "property_type",
    "monthly_bill"
  ],
  "properties": {
    "customer_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Customer full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Customer email address"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+?60[0-9]{9,10}$",
      "description": "Customer phone number (Malaysian format)"
    },
    "address": {
      "type": "string",
      "minLength": 10,
      "description": "Property address"
    },
    "property_type": {
      "type": "string",
      "enum": ["residential", "commercial", "industrial"],
      "description": "Type of property"
    },
    "monthly_bill": {
      "type": "number",
      "minimum": 0,
      "description": "Average monthly electricity bill in MYR"
    },
    "roof_type": {
      "type": "string",
      "enum": ["metal", "concrete", "shingle", "tile", "unknown"],
      "description": "Type of roof (if known)"
    },
    "roof_area_sqm": {
      "type": "number",
      "minimum": 0,
      "description": "Roof area in square meters (if known)"
    },
    "priority_notes": {
      "type": "string",
      "description": "Additional notes for lead prioritization"
    },
    "source": {
      "type": "string",
      "enum": ["website", "referral", "walk_in", "phone", "email", "social_media"],
      "description": "Lead source"
    }
  },
  "additionalProperties": false
}

