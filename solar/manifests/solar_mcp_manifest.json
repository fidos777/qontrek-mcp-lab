{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "mcp_version": "1.0",
  "name": "solar-mcp-toolpack",

  "metadata": {
    "vertical": "solar",
    "version": "0.1.0",
    "owner": "Qontrek",
    "description": "Solar vertical toolpack for MCP",
    "license": "MIT",
    "repository": "https://github.com/qontrek/solar-mcp-toolpack",
    "documentation_url": "https://docs.qontrek.com/solar",
    "created_at": "2025-12-05",
    "updated_at": "2025-12-05",
    "authors": [
      {
        "name": "Qontrek MCP Lab",
        "email": "mcp-lab@qontrek.com"
      }
    ],
    "tags": [
      "solar",
      "renewable-energy",
      "sales",
      "crm",
      "document-generation",
      "malaysia"
    ],
    "industry": "renewable_energy",
    "region": "asia_pacific"
  },

  "capability_summary": {
    "description": "End-to-end solar sales workflow automation from lead capture to quotation delivery",
    "primary_functions": [
      "Lead capture and qualification scoring",
      "Site inspection and technical assessment",
      "ROI calculation with financial projections",
      "Professional quotation document generation"
    ],
    "supported_capabilities": {
      "tools": true,
      "resources": true,
      "prompts": true,
      "logging": true
    },
    "workflow_patterns": [
      {
        "name": "full_sales_cycle",
        "description": "Complete lead-to-quote workflow",
        "sequence": ["lead_intake", "site_inspection", "roi_calculator", "quotation_builder"]
      },
      {
        "name": "quick_estimate",
        "description": "Fast estimate without site visit",
        "sequence": ["lead_intake", "roi_calculator"]
      },
      {
        "name": "requote",
        "description": "Generate revised quotation from existing data",
        "sequence": ["roi_calculator", "quotation_builder"]
      }
    ]
  },

  "healthcheck": {
    "endpoint": "/health",
    "method": "GET",
    "description": "Health check endpoint to verify MCP server status",
    "expected_response": {
      "status": "healthy",
      "version": "0.1.0",
      "tools_loaded": 4,
      "uptime_seconds": "number"
    },
    "timeout_ms": 5000,
    "interval_seconds": 30
  },

  "tools": [
    {
      "name": "lead_intake",
      "description": "Captures and qualifies customer information for solar installation leads. Collects contact details, property information, and automatically scores leads based on qualification criteria.",
      "definition": {
        "$ref": "../tools/lead_intake.json"
      },
      "category": "sales",
      "annotations": {
        "title": "Lead Intake",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "site_inspection",
      "description": "Captures technical details of a solar installation site including roof specifications, panel layout recommendations, and shading analysis.",
      "definition": {
        "$ref": "../tools/site_inspection.json"
      },
      "category": "technical",
      "annotations": {
        "title": "Site Inspection",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "roi_calculator",
      "description": "Calculates return on investment, payback period, and comprehensive financial projections for solar installations based on site data.",
      "definition": {
        "$ref": "../tools/roi_calculator.json"
      },
      "category": "finance",
      "annotations": {
        "title": "ROI Calculator",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "quotation_builder",
      "description": "Transforms ROI calculations into professional quotation documents in PDF, DOCX, or PPTX formats via Qontrek Document Factory integration.",
      "definition": {
        "$ref": "../tools/quotation_builder.json"
      },
      "category": "documents",
      "annotations": {
        "title": "Quotation Builder",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    }
  ],

  "tool_permissions": {
    "lead_intake": {
      "required_scopes": ["solar:lead:write"],
      "rate_limit": {
        "requests_per_minute": 100,
        "requests_per_day": 5000
      },
      "data_access": ["leads", "agents"],
      "pii_handling": true
    },
    "site_inspection": {
      "required_scopes": ["solar:inspection:write", "solar:lead:read"],
      "rate_limit": {
        "requests_per_minute": 30,
        "requests_per_day": 500
      },
      "data_access": ["leads", "site_inspections"],
      "pii_handling": false
    },
    "roi_calculator": {
      "required_scopes": ["solar:roi:write", "solar:inspection:read"],
      "rate_limit": {
        "requests_per_minute": 60,
        "requests_per_day": 1000
      },
      "data_access": ["site_inspections", "roi_calculations", "tariffs"],
      "pii_handling": false
    },
    "quotation_builder": {
      "required_scopes": ["solar:quotation:write", "solar:roi:read", "documents:generate"],
      "rate_limit": {
        "requests_per_minute": 20,
        "requests_per_day": 200
      },
      "data_access": ["leads", "roi_calculations", "quotations", "templates"],
      "external_api_access": ["qontrek_document_factory"],
      "pii_handling": true
    }
  },

  "resources": [
    {
      "uri": "solar://leads",
      "name": "Solar Leads",
      "description": "Access to solar installation leads database",
      "mimeType": "application/json"
    },
    {
      "uri": "solar://inspections",
      "name": "Site Inspections",
      "description": "Access to site inspection records",
      "mimeType": "application/json"
    },
    {
      "uri": "solar://calculations",
      "name": "ROI Calculations",
      "description": "Access to ROI calculation records",
      "mimeType": "application/json"
    },
    {
      "uri": "solar://quotations",
      "name": "Quotations",
      "description": "Access to quotation documents and status",
      "mimeType": "application/json"
    },
    {
      "uri": "solar://templates",
      "name": "Quote Templates",
      "description": "Available quotation document templates",
      "mimeType": "application/json"
    },
    {
      "uri": "solar://tariffs",
      "name": "Electricity Tariffs",
      "description": "Current TNB electricity tariff rates",
      "mimeType": "application/json"
    },
    {
      "uri": "solar://equipment",
      "name": "Equipment Catalog",
      "description": "Catalog of solar panels, inverters, and accessories",
      "mimeType": "application/json"
    }
  ],

  "prompts": [
    {
      "name": "solar_sales_assistant",
      "description": "System prompt for a solar sales AI assistant",
      "arguments": [
        {
          "name": "company_name",
          "description": "Name of the solar installation company",
          "required": true
        },
        {
          "name": "region",
          "description": "Operating region (e.g., 'Malaysia', 'Selangor')",
          "required": false
        }
      ]
    },
    {
      "name": "site_survey_guide",
      "description": "Step-by-step guide for conducting site surveys",
      "arguments": [
        {
          "name": "property_type",
          "description": "Type of property (residential, commercial, industrial)",
          "required": true
        }
      ]
    },
    {
      "name": "objection_handler",
      "description": "Common objections and recommended responses for solar sales",
      "arguments": [
        {
          "name": "objection_category",
          "description": "Category of objection (price, timing, trust, technical)",
          "required": false
        }
      ]
    }
  ],

  "example_agent_request": {
    "description": "Example request demonstrating a full sales cycle workflow",
    "scenario": "New residential lead captured from website, processed through complete workflow",
    "request": {
      "workflow": "full_sales_cycle",
      "steps": [
        {
          "tool": "lead_intake",
          "input": {
            "customer_name": "Ahmad bin Abdullah",
            "address": "123 Jalan Maju, Taman Sentosa, 47810 Petaling Jaya, Selangor",
            "contact_phone": "+60123456789",
            "contact_email": "ahmad@example.com",
            "property_type": "residential",
            "monthly_electricity_bill_myr": 650,
            "source": "website",
            "budget_range": "30000_50000",
            "timeline": "within_1_month",
            "ownership_status": "owner"
          },
          "expected_output": {
            "lead_id": "uuid",
            "lead_score": 85,
            "qualification_status": "hot",
            "next_step": "site_inspection"
          }
        },
        {
          "tool": "site_inspection",
          "input": {
            "lead_id": "{{lead_intake.output.lead_id}}",
            "roof_type": "concrete_flat",
            "roof_area_sqm": 150.5,
            "roof_orientation": "south",
            "roof_tilt_degrees": 10,
            "shading_factor": 0.15
          },
          "expected_output": {
            "inspection_id": "uuid",
            "recommended_system_size_kwp": 17.6,
            "next_step": "roi_calculator"
          }
        },
        {
          "tool": "roi_calculator",
          "input": {
            "site_inspection_id": "{{site_inspection.output.inspection_id}}",
            "system_size_kwp": "{{site_inspection.output.recommended_system_size_kwp}}",
            "monthly_bill_myr": 650
          },
          "expected_output": {
            "roi_id": "uuid",
            "financial_summary": {
              "simple_payback_years": 5.9,
              "lifetime_savings_myr": 425000
            },
            "next_step": "quotation_builder"
          }
        },
        {
          "tool": "quotation_builder",
          "input": {
            "roi_calculation_id": "{{roi_calculator.output.roi_id}}",
            "output_formats": ["pdf", "docx"],
            "template_id": "standard",
            "validity_days": 30
          },
          "expected_output": {
            "quotation_id": "uuid",
            "quote_number": "QT-2025-00042",
            "document_urls": {
              "pdf": "https://storage.qontrek.com/quotes/QT-2025-00042.pdf"
            },
            "status": "generated"
          }
        }
      ]
    }
  },

  "server": {
    "command": "npx",
    "args": ["-y", "@qontrek/solar-mcp-server"],
    "env": {
      "SUPABASE_URL": {
        "description": "Supabase project URL",
        "required": true
      },
      "SUPABASE_ANON_KEY": {
        "description": "Supabase anonymous key",
        "required": true
      },
      "SUPABASE_SERVICE_KEY": {
        "description": "Supabase service role key (for admin operations)",
        "required": false
      },
      "QONTREK_API_KEY": {
        "description": "Qontrek Document Factory API key",
        "required": true
      },
      "QONTREK_WEBHOOK_SECRET": {
        "description": "Webhook signature verification secret",
        "required": false
      },
      "FIRECRAWL_API_KEY": {
        "description": "FireCrawl API key for brand scraping (optional)",
        "required": false
      }
    },
    "transport": {
      "type": "stdio"
    }
  },

  "integrations": {
    "supabase": {
      "description": "Primary data storage and authentication",
      "required": true,
      "tables": ["leads", "site_inspections", "roi_calculations", "quotations", "agents", "organizations"],
      "storage_buckets": ["inspection-images", "quotation-documents"]
    },
    "qontrek_document_factory": {
      "description": "Document generation service",
      "required": true,
      "capabilities": ["pdf_generation", "docx_generation", "pptx_generation", "template_management"]
    },
    "firecrawl": {
      "description": "Web scraping for lead enrichment",
      "required": false,
      "capabilities": ["website_scraping", "contact_extraction"]
    }
  },

  "webhooks": {
    "endpoints": [
      {
        "event": "lead.created",
        "description": "Triggered when a new lead is created"
      },
      {
        "event": "lead.qualified",
        "description": "Triggered when a lead is qualified as hot/warm"
      },
      {
        "event": "inspection.completed",
        "description": "Triggered when site inspection is completed"
      },
      {
        "event": "quote.generated",
        "description": "Triggered when quotation is generated"
      },
      {
        "event": "quote.viewed",
        "description": "Triggered when customer views quotation"
      },
      {
        "event": "quote.accepted",
        "description": "Triggered when customer accepts quotation"
      }
    ],
    "authentication": {
      "type": "hmac-sha256",
      "header": "X-Qontrek-Signature"
    }
  },

  "security": {
    "authentication": {
      "type": "api_key",
      "header": "Authorization",
      "scheme": "Bearer"
    },
    "authorization": {
      "type": "rbac",
      "roles": ["admin", "manager", "agent", "viewer"]
    },
    "data_protection": {
      "encryption_at_rest": true,
      "encryption_in_transit": true,
      "pii_handling": "mask_in_logs"
    }
  },

  "logging": {
    "level": "info",
    "format": "json",
    "include_request_body": false,
    "include_response_body": false,
    "retention_days": 90
  }
}
