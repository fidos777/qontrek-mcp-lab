{
  "name": "quotation_builder",
  "type": "function",
  "version": "1.0.0",
  "description": "Transforms ROI calculations into professional quotation documents. Generates PDF, DOCX, and PPTX formats with customizable templates, pricing breakdowns, and terms. Integrates with Qontrek Document Factory for high-quality document generation.",
  "category": "solar",
  "tags": ["solar", "quotation", "quote", "document", "pdf", "proposal", "sales"],
  "arguments": [
    {
      "name": "roi_calculation_id",
      "type": "string",
      "required": true,
      "description": "Reference to the ROI calculation record (UUID format)"
    },
    {
      "name": "customer_profile",
      "type": "object",
      "required": false,
      "description": "Customer profile including customer_name, customer_type, billing_address, installation_address, contact details"
    },
    {
      "name": "roi_model",
      "type": "object",
      "required": false,
      "description": "ROI model summary including system_size_kwp, annual_savings, payback_period, lifetime_savings"
    },
    {
      "name": "package_options",
      "type": "array",
      "required": false,
      "description": "Array of package options with different configurations and pricing"
    },
    {
      "name": "add_ons",
      "type": "array",
      "required": false,
      "description": "Array of available add-ons like monitoring, battery storage, maintenance plans"
    },
    {
      "name": "discounts",
      "type": "object",
      "required": false,
      "description": "Discount information including discount_type, discount_value, discount_reason"
    },
    {
      "name": "payment_plan",
      "type": "object",
      "required": false,
      "description": "Payment plan details including payment_method, financing_partner, installment details"
    },
    {
      "name": "output_formats",
      "type": "array",
      "required": false,
      "description": "Output document formats to generate",
      "default": ["pdf"],
      "enum": ["pdf", "docx", "pptx", "xlsx"]
    },
    {
      "name": "template_id",
      "type": "string",
      "required": false,
      "description": "Template to use for document generation",
      "default": "standard"
    },
    {
      "name": "validity_days",
      "type": "integer",
      "required": false,
      "description": "Number of days quote is valid",
      "default": 30
    },
    {
      "name": "language",
      "type": "string",
      "required": false,
      "description": "Document language",
      "default": "en",
      "enum": ["en", "ms", "zh"]
    }
  ],
  "input_schema": {
    "$ref": "../schemas/quotation_builder.schema.json",
    "required": ["roi_calculation_id"],
    "properties": {
      "roi_calculation_id": {
        "type": "string",
        "format": "uuid",
        "description": "Reference to the ROI calculation record"
      },
      "customer_profile": {
        "type": "object",
        "description": "Customer profile and contact information"
      },
      "roi_model": {
        "type": "object",
        "description": "ROI calculation model summary"
      },
      "package_options": {
        "type": "array",
        "description": "Available package options for the customer"
      },
      "add_ons": {
        "type": "array",
        "description": "Available add-ons and extras"
      },
      "discounts": {
        "type": "object",
        "description": "Discount information"
      },
      "payment_plan": {
        "type": "object",
        "description": "Payment plan and financing details"
      },
      "output_formats": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["pdf", "docx", "pptx", "xlsx"]
        },
        "default": ["pdf"],
        "description": "Output document formats to generate"
      },
      "template_id": {
        "type": "string",
        "default": "standard",
        "description": "Template to use for document generation"
      },
      "validity_days": {
        "type": "integer",
        "minimum": 7,
        "maximum": 90,
        "default": 30,
        "description": "Number of days quote is valid"
      },
      "language": {
        "type": "string",
        "enum": ["en", "ms", "zh"],
        "default": "en",
        "description": "Document language"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "quotation_id": {
        "type": "string",
        "format": "uuid",
        "description": "Unique identifier for this quotation"
      },
      "quote_number": {
        "type": "string",
        "pattern": "^QT-[0-9]{4}-[0-9]{5}$",
        "description": "Human-readable quote reference number"
      },
      "roi_calculation_id": {
        "type": "string",
        "format": "uuid",
        "description": "Reference to ROI calculation"
      },
      "lead_id": {
        "type": "string",
        "format": "uuid",
        "description": "Reference to lead record"
      },
      "customer_name": {
        "type": "string",
        "description": "Customer name"
      },
      "system_summary": {
        "type": "object",
        "properties": {
          "system_size_kw": {
            "type": "number"
          },
          "panel_count": {
            "type": "integer"
          },
          "panel_brand": {
            "type": "string"
          },
          "inverter_brand": {
            "type": "string"
          }
        }
      },
      "pricing_summary": {
        "type": "object",
        "properties": {
          "subtotal_myr": {
            "type": "number"
          },
          "discount_myr": {
            "type": "number"
          },
          "tax_myr": {
            "type": "number"
          },
          "total_amount_myr": {
            "type": "number"
          },
          "price_per_kw_myr": {
            "type": "number"
          }
        }
      },
      "roi_highlights": {
        "type": "object",
        "properties": {
          "payback_years": {
            "type": "number"
          },
          "annual_savings_myr": {
            "type": "number"
          },
          "lifetime_savings_myr": {
            "type": "number"
          }
        }
      },
      "validity": {
        "type": "object",
        "properties": {
          "quote_date": {
            "type": "string",
            "format": "date"
          },
          "valid_until": {
            "type": "string",
            "format": "date"
          },
          "validity_days": {
            "type": "integer"
          }
        }
      },
      "document_urls": {
        "type": "object",
        "properties": {
          "pdf": {
            "type": "string",
            "format": "uri",
            "description": "URL to generated PDF"
          },
          "docx": {
            "type": "string",
            "format": "uri",
            "description": "URL to generated DOCX"
          },
          "pptx": {
            "type": "string",
            "format": "uri",
            "description": "URL to generated PPTX"
          },
          "xlsx": {
            "type": "string",
            "format": "uri",
            "description": "URL to generated XLSX"
          }
        },
        "description": "URLs to generated documents"
      },
      "qontrek_job_id": {
        "type": "string",
        "description": "Qontrek Document Factory job ID"
      },
      "status": {
        "type": "string",
        "enum": ["draft", "generated", "sent", "viewed", "accepted", "rejected", "expired"],
        "description": "Current quotation status"
      },
      "shareable_link": {
        "type": "string",
        "format": "uri",
        "description": "Public link for customer to view quote"
      },
      "next_steps": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Recommended next steps"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": ["quotation_id", "quote_number", "pricing_summary", "document_urls", "status"]
  },
  "sample_request": {
