{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["brand_name"],
  "properties": {
    "brand_name": {
      "type": "string",
      "minLength": 2,
      "description": "Brand name"
    },
    "branding": {
      "type": "object",
      "description": "Branding output from branding.generate.v1"
    },
    "prd": {
      "type": "object",
      "description": "PRD output from prd.generate.v1"
    },
    "pricing": {
      "type": "object",
      "description": "Pricing output from pricing.generate.v1"
    },
    "roadmap": {
      "type": "object",
      "description": "Roadmap output from roadmap.generate.v1"
    }
  }
}
