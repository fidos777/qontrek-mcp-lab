{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Generate landing page structure with conversion-optimized sections",
  "required": ["page_title", "page_goal", "product_name", "value_proposition", "target_audience", "key_benefits", "cta_primary", "tone"],
  "properties": {
    "page_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Page title and H1"
    },
    "page_goal": {
      "type": "string",
      "enum": ["lead_generation", "product_sale", "signup", "download", "registration"],
      "description": "Primary conversion goal"
    },
    "product_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Product or offering name"
    },
    "value_proposition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Core value proposition statement"
    },
    "target_audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Target audience description"
    },
    "key_benefits": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 3,
      "maxItems": 6,
      "description": "Main benefits for the user"
    },
    "cta_primary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Primary call-to-action text"
    },
    "tone": {
      "type": "string",
      "enum": ["professional", "friendly", "urgent", "inspirational"],
      "description": "Content tone"
    },
    "features": {
      "type": "array",
      "items": {"type": "object"},
      "description": "Product features"
    },
    "social_proof": {
      "type": "object",
      "description": "Social proof elements"
    },
    "cta_secondary": {
      "type": "string",
      "description": "Secondary CTA text"
    },
    "include_faq": {
      "type": "boolean",
      "default": true,
      "description": "Include FAQ section"
    },
    "include_video": {
      "type": "boolean",
      "default": false,
      "description": "Include video placeholder"
    }
  }
}
