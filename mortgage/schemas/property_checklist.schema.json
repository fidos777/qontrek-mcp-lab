{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Property Checklist Schema",
  "description": "Schema for property validation and classification (new unit vs subsale)",
  "required": [
    "property_address",
    "property_type",
    "developer_name"
  ],
  "properties": {
    "property_address": {
      "type": "string",
      "minLength": 10,
      "description": "Full property address"
    },
    "property_type": {
      "type": "string",
      "enum": ["condominium", "apartment", "terrace", "semi_detached", "bungalow", "townhouse"],
      "description": "Type of property"
    },
    "developer_name": {
      "type": "string",
      "description": "Name of property developer"
    },
    "unit_number": {
      "type": "string",
      "description": "Unit/lot number"
    },
    "square_feet": {
      "type": "number",
      "minimum": 0,
      "description": "Property size in square feet"
    },
    "completion_certificate": {
      "type": "string",
      "enum": ["ccc", "oc", "pending", "not_applicable"],
      "description": "Completion certificate status (CCC/OC)"
    },
    "strata_title": {
      "type": "boolean",
      "description": "Whether property has strata title"
    },
    "individual_title": {
      "type": "boolean",
      "description": "Whether property has individual title"
    },
    "first_owner": {
      "type": "string",
      "description": "Name of first registered owner"
    },
    "first_owner_ic": {
      "type": "string",
      "pattern": "^[0-9]{6}-[0-9]{2}-[0-9]{4}$",
      "description": "First owner IC number"
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "description": "Property registration date (YYYY-MM-DD)"
    },
    "is_new_unit": {
      "type": "boolean",
      "description": "Whether property is a new unit (vs subsale)"
    },
    "subsale_evidence": {
      "type": "string",
      "description": "Evidence of subsale transaction if applicable"
    },
    "valuation_report": {
      "type": "boolean",
      "description": "Whether valuation report is available"
    },
    "valuation_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Valuation amount in MYR"
    }
  },
  "additionalProperties": false
}

