{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Lawyer Intake Schema",
  "description": "Schema for Sale & Purchase (S&P) agreement and panel lawyer details",
  "required": [
    "customer_ic",
    "property_address",
    "snp_date",
    "lawyer_firm_name"
  ],
  "properties": {
    "customer_ic": {
      "type": "string",
      "pattern": "^[0-9]{6}-[0-9]{2}-[0-9]{4}$",
      "description": "Customer IC number"
    },
    "property_address": {
      "type": "string",
      "minLength": 10,
      "description": "Full property address"
    },
    "snp_date": {
      "type": "string",
      "format": "date",
      "description": "Sale & Purchase agreement date (YYYY-MM-DD)"
    },
    "lawyer_firm_name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the law firm handling S&P"
    },
    "lawyer_name": {
      "type": "string",
      "description": "Name of the assigned lawyer"
    },
    "lawyer_contact": {
      "type": "string",
      "pattern": "^\\+?60[0-9]{9,10}$",
      "description": "Lawyer contact number"
    },
    "lawyer_email": {
      "type": "string",
      "format": "email",
      "description": "Lawyer email address"
    },
    "snp_number": {
      "type": "string",
      "description": "S&P agreement reference number"
    },
    "vendor_name": {
      "type": "string",
      "description": "Property vendor/seller name"
    },
    "vendor_ic": {
      "type": "string",
      "pattern": "^[0-9]{6}-[0-9]{2}-[0-9]{4}$",
      "description": "Vendor IC number (if individual)"
    },
    "purchase_price": {
      "type": "number",
      "minimum": 0,
      "description": "Purchase price as per S&P"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "Expected completion date (YYYY-MM-DD)"
    },
    "is_panel_lawyer": {
      "type": "boolean",
      "description": "Whether lawyer is on approved panel"
    }
  },
  "additionalProperties": false
}

