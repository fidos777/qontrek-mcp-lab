{
  "name": "roi_calculator",
  "type": "function",
  "version": "1.0.0",
  "description": "Calculates return on investment, payback period, and comprehensive financial projections for solar installations. Accepts site inspection data or manual input to produce detailed ROI models including sensitivity analysis and year-by-year projections.",
  "category": "solar",
  "tags": ["solar", "roi", "finance", "payback", "savings", "calculator"],
  "arguments": [
    {
      "name": "site_inspection_id",
      "type": "string",
      "required": false,
      "description": "Reference to site inspection record (UUID format)"
    },
    {
      "name": "upfront_cost",
      "type": "number",
      "required": false,
      "description": "Total upfront cost of the solar system installation in MYR"
    },
    {
      "name": "annual_savings",
      "type": "number",
      "required": false,
      "description": "Estimated annual electricity savings in MYR (calculated if not provided)"
    },
    {
      "name": "payback_years",
      "type": "number",
      "required": false,
      "description": "Simple payback period in years (calculated if not provided)"
    },
    {
      "name": "inverter_cost",
      "type": "number",
      "required": false,
      "description": "Cost of inverter equipment in MYR"
    },
    {
      "name": "panel_rating_kw",
      "type": "number",
      "required": false,
      "description": "Individual panel power rating in kW (e.g., 0.55 for 550W panel)"
    },
    {
      "name": "system_size_kw",
      "type": "number",
      "required": true,
      "description": "Total system size in kilowatts"
    },
    {
      "name": "tnb_tariff",
      "type": "object",
      "required": false,
      "description": "TNB electricity tariff structure including tariff_category, tariff_rate_myr_kwh, nem_export_rate_myr_kwh"
    },
    {
      "name": "assumptions",
      "type": "object",
      "required": false,
      "description": "Calculation assumptions including annual_irradiance_kwh_m2, performance_ratio, degradation_rate, electricity_price_escalation"
    },
    {
      "name": "monthly_bill_myr",
      "type": "number",
      "required": false,
      "description": "Current monthly electricity bill in MYR"
    },
    {
      "name": "installation_cost_per_kwp",
      "type": "number",
      "required": false,
      "description": "Installation cost per kWp in MYR",
      "default": 3800
    }
  ],
  "input_schema": {
    "$ref": "../schemas/roi_calculator.schema.json",
    "required": ["system_size_kw"],
    "properties": {
      "site_inspection_id": {
        "type": "string",
        "format": "uuid",
        "description": "Reference to site inspection record"
      },
      "upfront_cost": {
        "type": "number",
        "minimum": 0,
        "description": "Total upfront cost of the solar system installation in MYR"
      },
      "annual_savings": {
        "type": "number",
        "minimum": 0,
        "description": "Estimated annual electricity savings in MYR"
      },
      "payback_years": {
        "type": "number",
        "minimum": 0,
        "description": "Simple payback period in years"
      },
      "inverter_cost": {
        "type": "number",
        "minimum": 0,
        "description": "Cost of inverter equipment in MYR"
      },
      "panel_rating_kw": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 1,
        "description": "Individual panel power rating in kW"
      },
      "system_size_kw": {
        "type": "number",
        "minimum": 1,
        "maximum": 1000,
        "description": "Total system size in kilowatts"
      },
      "tnb_tariff": {
        "type": "object",
        "description": "TNB electricity tariff structure"
      },
      "assumptions": {
        "type": "object",
        "description": "Calculation assumptions"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "roi_id": {
        "type": "string",
        "format": "uuid",
        "description": "Unique identifier for this ROI calculation"
      },
      "site_inspection_id": {
        "type": "string",
        "format": "uuid",
        "description": "Reference to site inspection if provided"
      },
      "system_specifications": {
        "type": "object",
        "properties": {
          "system_size_kw": {
            "type": "number"
          },
          "estimated_panels": {
            "type": "integer"
          },
          "annual_generation_kwh": {
            "type": "number"
          }
        }
      },
      "financial_summary": {
        "type": "object",
        "properties": {
          "upfront_cost_myr": {
            "type": "number"
          },
          "first_year_savings_myr": {
            "type": "number"
          },
          "annual_savings_myr": {
            "type": "number"
          },
          "lifetime_savings_myr": {
            "type": "number"
          },
          "simple_payback_years": {
            "type": "number"
          },
          "discounted_payback_years": {
            "type": "number"
          },
          "npv_myr": {
            "type": "number"
          },
          "irr_percentage": {
            "type": "number"
          },
          "roi_percentage": {
            "type": "number"
          },
          "lcoe_myr_kwh": {
            "type": "number"
          }
        }
      },
      "environmental_impact": {
        "type": "object",
        "properties": {
          "carbon_offset_tonnes_year": {
            "type": "number"
          },
          "lifetime_carbon_offset_tonnes": {
            "type": "number"
          },
          "trees_equivalent": {
            "type": "integer"
          }
        }
      },
      "year_by_year_projection": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "year": {
              "type": "integer"
            },
            "generation_kwh": {
              "type": "number"
            },
            "savings_myr": {
              "type": "number"
            },
            "cumulative_savings_myr": {
              "type": "number"
            },
            "cumulative_net_benefit_myr": {
              "type": "number"
            }
          }
        }
      },
      "sensitivity_analysis": {
        "type": "object",
        "properties": {
          "conservative": {
            "type": "object",
            "properties": {
              "payback_years": {
                "type": "number"
              },
              "lifetime_savings_myr": {
                "type": "number"
              }
            }
          },
          "base": {
            "type": "object",
            "properties": {
              "payback_years": {
                "type": "number"
              },
              "lifetime_savings_myr": {
                "type": "number"
              }
            }
          },
          "optimistic": {
            "type": "object",
            "properties": {
              "payback_years": {
                "type": "number"
              },
              "lifetime_savings_myr": {
                "type": "number"
              }
            }
          }
        }
      },
      "assumptions_used": {
        "type": "object",
        "description": "All assumptions used in calculation"
      },
      "next_step": {
        "type": "string",
        "const": "quotation_builder",
        "description": "Downstream tool to invoke"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": ["roi_id", "financial_summary", "next_step"]
  },
  "sample_request": {
    "site_inspection_id": "660e8400-e29b-41d4-a716-446655440001",
    "system_size_kw": 17.6,
    "panel_rating_kw": 0.55,
    "upfront_cost": 66880,
    "inverter_cost": 8000,
    "tnb_tariff": {
      "tariff_category": "domestic",
      "tariff_rate_myr_kwh": 0.57,
      "nem_export_rate_myr_kwh": 0.31
    },
    "assumptions": {
      "annual_irradiance_kwh_m2": 1600,
      "performance_ratio": 0.8,
      "shading_factor": 0.15,
      "orientation_factor": 0.95,
      "annual_degradation_rate": 0.005,
      "electricity_price_escalation": 0.04,
      "discount_rate": 0.06,
      "projection_years": 25
    },
    "monthly_bill_myr": 800
  },
  "sample_response": {
    "roi_id": "770e8400-e29b-41d4-a716-446655440002",
    "site_inspection_id": "660e8400-e29b-41d4-a716-446655440001",
    "system_specifications": {
      "system_size_kw": 17.6,
      "estimated_panels": 32,
      "annual_generation_kwh": 19894
    },
    "financial_summary": {
      "upfront_cost_myr": 66880,
      "first_year_savings_myr": 11340,
      "annual_savings_myr": 11340,
      "lifetime_savings_myr": 425000,
      "simple_payback_years": 5.9,
      "discounted_payback_years": 7.2,
      "npv_myr": 125000,
      "irr_percentage": 18.5,
      "roi_percentage": 535,
      "lcoe_myr_kwh": 0.18
    },
    "environmental_impact": {
      "carbon_offset_tonnes_year": 13.9,
      "lifetime_carbon_offset_tonnes": 347.5,
      "trees_equivalent": 580
    },
    "year_by_year_projection": [
      {
        "year": 1,
        "generation_kwh": 19894,
        "savings_myr": 11340,
        "cumulative_savings_myr": 11340,
        "cumulative_net_benefit_myr": -55540
      },
      {
        "year": 2,
        "generation_kwh": 19794,
        "savings_myr": 11794,
        "cumulative_savings_myr": 23134,
        "cumulative_net_benefit_myr": -43746
      }
    ],
    "sensitivity_analysis": {
      "conservative": {
        "payback_years": 7.4,
        "lifetime_savings_myr": 340000
      },
      "base": {
        "payback_years": 5.9,
        "lifetime_savings_myr": 425000
      },
      "optimistic": {
        "payback_years": 4.8,
        "lifetime_savings_myr": 520000
      }
    },
    "assumptions_used": {
      "annual_irradiance_kwh_m2": 1600,
      "performance_ratio": 0.8,
      "inflation_rate": 0.03,
      "electricity_escalation": 0.04
    },
    "next_step": "quotation_builder",
    "created_at": "2025-12-05T10:35:00Z"
  },
  "downstream_dependency": {
    "tool": "quotation_builder",
    "description": "ROI calculation results feed into quotation builder for professional quote generation. The roi_id, financial_summary, and system_specifications are passed to create customer-facing quotation documents.",
    "required_fields": ["roi_id", "financial_summary", "system_specifications"]
  },
  "dependencies": {
    "upstream": ["site_inspection"],
    "downstream": ["quotation_builder"]
  },
  "execution": {
    "timeout_ms": 5000,
    "retry_policy": {
      "max_retries": 2,
      "backoff_ms": 500
    },
    "idempotent": true,
    "cacheable": true,
    "cache_ttl_seconds": 3600
  },
  "validation": {
    "strict_mode": true,
    "coerce_types": true,
    "allow_partial_input": true
  },
  "permissions": {
    "required_scopes": ["solar:roi:write", "solar:inspection:read"],
    "rate_limit": {
      "requests_per_minute": 60,
      "requests_per_day": 1000
    }
  },
  "metadata": {
    "author": "Qontrek MCP Lab",
    "created_at": "2025-12-05",
    "updated_at": "2025-12-05",
    "documentation_url": "https://docs.qontrek.com/solar/tools/roi_calculator"
  }
}
