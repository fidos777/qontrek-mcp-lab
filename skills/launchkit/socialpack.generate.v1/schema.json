{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["brand_name", "value_proposition"],
  "properties": {
    "brand_name": {
      "type": "string",
      "minLength": 2,
      "description": "Brand name"
    },
    "value_proposition": {
      "type": "string",
      "minLength": 10,
      "description": "Value proposition"
    },
    "messaging_framework": {
      "type": "object",
      "properties": {
        "key_messages": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "unified_tone": {
      "type": "string",
      "default": "professional",
      "enum": ["professional", "playful", "inspirational", "bold", "minimalist"]
    },
    "launch_date": {
      "type": "string",
      "description": "Launch date (ISO 8601 or human-readable)"
    },
    "target_audience": {
      "type": "string",
      "description": "Target audience description"
    }
  }
}
