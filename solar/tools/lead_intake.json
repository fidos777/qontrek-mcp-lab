{
  "name": "lead_intake",
  "description": "Parse customer information, classify commercial vs residential, and flag high-priority leads. Processes Voltek flow lead data and determines priority based on property type and monthly bill.",
  "inputSchema": {
    "$ref": "../schemas/lead_intake.schema.json"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": ["success", "error"]
      },
      "normalized_data": {
        "type": "object",
        "properties": {
          "customer_name": {"type": "string"},
          "email": {"type": "string"},
          "phone": {"type": "string"},
          "address": {"type": "string"},
          "property_type": {"type": "string"},
          "monthly_bill": {"type": "number"},
          "priority_score": {"type": "number"},
          "is_high_priority": {"type": "boolean"},
          "estimated_system_size_kw": {"type": "number"},
          "lead_form_fields": {"type": "object"}
        }
      },
      "proposal_payload": {
        "type": "object"
      },
      "errors": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  }
}

