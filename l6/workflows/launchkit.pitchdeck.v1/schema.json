{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LaunchKit Pitchdeck Workflow Input",
  "description": "Generates slide-by-slide pitchdeck content",
  "type": "object",
  "required": [
    "branding",
    "prd",
    "pricing",
    "roadmap"
  ],
  "properties": {
    "branding": {
      "type": "object",
      "description": "Branding output from launchkit.branding.v1",
      "properties": {
        "brand_story": {"type": "string"},
        "mission_statement": {"type": "string"},
        "vision_statement": {"type": "string"},
        "positioning_statement": {"type": "string"},
        "value_prop_block": {"type": "object"}
      }
    },
    "prd": {
      "type": "object",
      "description": "PRD output from launchkit.prd.v1",
      "properties": {
        "problem_statement": {"type": "string"},
        "solution_overview": {"type": "string"},
        "user_personas": {"type": "array"},
        "feature_list": {"type": "object"}
      }
    },
    "pricing": {
      "type": "object",
      "description": "Pricing output from launchkit.pricing.v1",
      "properties": {
        "tiers": {"type": "array"},
        "pricing_narrative": {"type": "string"}
      }
    },
    "roadmap": {
      "type": "object",
      "description": "Roadmap output from launchkit.roadmap.v1",
      "properties": {
        "milestones": {"type": "array"},
        "phases": {"type": "object"}
      }
    },
    "team": {
      "type": "array",
      "description": "Team members (optional)",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "bio": {"type": "string"}
        }
      }
    },
    "market_data": {
      "type": "object",
      "description": "Market size and opportunity data (optional)",
      "properties": {
        "tam": {"type": "string"},
        "sam": {"type": "string"},
        "som": {"type": "string"}
      }
    }
  }
}
