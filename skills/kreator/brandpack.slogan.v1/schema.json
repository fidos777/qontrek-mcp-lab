{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qontrek.com/schemas/brandpack-slogan-v1.json",
  "title": "Brandpack Slogan Generator Input",
  "description": "Input schema for generating brand slogans and taglines",
  "type": "object",
  "required": ["brand_name", "industry", "target_audience", "brand_values", "tone"],
  "properties": {
    "brand_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Name of the brand"
    },
    "industry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Industry or sector of the brand"
    },
    "target_audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Description of the target audience"
    },
    "brand_values": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "minItems": 1,
      "maxItems": 10,
      "description": "Core brand values"
    },
    "tone": {
      "type": "string",
      "enum": ["professional", "playful", "inspirational", "bold", "minimalist"],
      "description": "Desired tone for the slogans"
    },
    "language": {
      "type": "string",
      "default": "en",
      "pattern": "^[a-z]{2}$",
      "description": "Two-letter language code (ISO 639-1)"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 5,
      "description": "Number of slogan variations to generate"
    }
  },
  "additionalProperties": false
}
