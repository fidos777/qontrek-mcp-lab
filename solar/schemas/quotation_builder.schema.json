{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qontrek.com/schemas/solar/quotation_builder.schema.json",
  "title": "Quotation Builder Schema",
  "description": "Schema for generating professional solar installation quotations with multiple output formats and Qontrek Document Factory integration",
  "type": "object",
  "required": ["roi_calculation_id"],
  "properties": {
    "quotation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this quotation"
    },
    "roi_calculation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the ROI calculation record"
    },
    "lead_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the lead/customer record"
    },
    "site_inspection_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to site inspection record"
    },
    "customer_profile": {
      "type": "object",
      "properties": {
        "customer_name": {
          "type": "string",
          "description": "Customer name"
        },
        "customer_type": {
          "type": "string",
          "enum": ["individual", "company", "government"],
          "description": "Type of customer"
        },
        "company_name": {
          "type": "string",
          "description": "Company name if applicable"
        },
        "billing_address": {
          "type": "string",
          "description": "Billing address"
        },
        "installation_address": {
          "type": "string",
          "description": "Installation site address"
        },
        "contact_person": {
          "type": "string",
          "description": "Primary contact person"
        },
        "contact_phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "contact_email": {
          "type": "string",
          "format": "email",
          "description": "Contact email address"
        },
        "income_range": {
          "type": "string",
          "description": "Customer income range"
        },
        "property_type": {
          "type": "string",
          "description": "Type of property"
        },
        "monthly_electricity_bill_myr": {
          "type": "number",
          "description": "Current monthly electricity bill"
        }
      },
      "description": "Customer profile and contact information"
    },
    "roi_model": {
      "type": "object",
      "properties": {
        "system_size_kwp": {
          "type": "number",
          "description": "System size in kWp"
        },
        "estimated_annual_generation_kwh": {
          "type": "number",
          "description": "Annual energy generation"
        },
        "estimated_annual_savings_myr": {
          "type": "number",
          "description": "Annual cost savings"
        },
        "payback_period_years": {
          "type": "number",
          "description": "Simple payback period"
        },
        "roi_percentage": {
          "type": "number",
          "description": "Return on investment"
        },
        "lifetime_savings_myr": {
          "type": "number",
          "description": "25-year lifetime savings"
        },
        "carbon_offset_tonnes_year": {
          "type": "number",
          "description": "Annual CO2 offset"
        },
        "npv_myr": {
          "type": "number",
          "description": "Net present value"
        },
        "irr_percentage": {
          "type": "number",
          "description": "Internal rate of return"
        }
      },
      "description": "ROI calculation model summary"
    },
    "package_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "package_id": {
            "type": "string",
            "description": "Unique package identifier"
          },
          "package_name": {
            "type": "string",
            "description": "Package display name"
          },
          "package_tier": {
            "type": "string",
            "enum": ["basic", "standard", "premium", "enterprise"],
            "description": "Package tier level"
          },
          "system_size_kwp": {
            "type": "number",
            "description": "System size in kWp"
          },
          "panel_brand": {
            "type": "string",
            "description": "Solar panel brand"
          },
          "panel_model": {
            "type": "string",
            "description": "Solar panel model"
          },
          "panel_count": {
            "type": "integer",
            "description": "Number of panels"
          },
          "inverter_brand": {
            "type": "string",
            "description": "Inverter brand"
          },
          "inverter_model": {
            "type": "string",
            "description": "Inverter model"
          },
          "includes_battery": {
            "type": "boolean",
            "default": false,
            "description": "Whether battery is included"
          },
          "battery_capacity_kwh": {
            "type": "number",
            "description": "Battery capacity if included"
          },
          "warranty_years": {
            "type": "integer",
            "description": "Warranty period in years"
          },
          "base_price_myr": {
            "type": "number",
            "description": "Base package price"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Package features list"
          },
          "is_recommended": {
            "type": "boolean",
            "default": false,
            "description": "Whether this is the recommended package"
          }
        }
      },
      "description": "Available package options for the customer"
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "addon_id": {
            "type": "string",
            "description": "Add-on identifier"
          },
          "addon_name": {
            "type": "string",
            "description": "Add-on display name"
          },
          "addon_category": {
            "type": "string",
            "enum": ["monitoring", "storage", "protection", "maintenance", "smart_home", "other"],
            "description": "Add-on category"
          },
          "description": {
            "type": "string",
            "description": "Add-on description"
          },
          "price_myr": {
            "type": "number",
            "description": "Add-on price"
          },
          "is_one_time": {
            "type": "boolean",
            "default": true,
            "description": "Whether this is a one-time or recurring cost"
          },
          "recurring_period": {
            "type": "string",
            "enum": ["monthly", "quarterly", "annually"],
            "description": "Recurring period if not one-time"
          },
          "is_selected": {
            "type": "boolean",
            "default": false,
            "description": "Whether add-on is selected"
          }
        }
      },
      "description": "Available add-ons and extras"
    },
    "discounts": {
      "type": "object",
      "properties": {
        "discount_type": {
          "type": "string",
          "enum": ["percentage", "fixed", "tiered"],
          "description": "Type of discount"
        },
        "discount_value": {
          "type": "number",
          "description": "Discount value (percentage or fixed amount)"
        },
        "discount_code": {
          "type": "string",
          "description": "Promo/discount code if applicable"
        },
        "discount_reason": {
          "type": "string",
          "description": "Reason for discount"
        },
        "discount_amount_myr": {
          "type": "number",
          "description": "Calculated discount amount in MYR"
        },
        "valid_until": {
          "type": "string",
          "format": "date",
          "description": "Discount validity date"
        },
        "terms_conditions": {
          "type": "string",
          "description": "Discount terms and conditions"
        },
        "stacked_discounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "discount_name": {
                "type": "string"
              },
              "discount_type": {
                "type": "string",
                "enum": ["percentage", "fixed"]
              },
              "discount_value": {
                "type": "number"
              },
              "discount_amount_myr": {
                "type": "number"
              }
            }
          },
          "description": "Multiple stacked discounts if applicable"
        }
      },
      "description": "Discount information"
    },
    "payment_plan": {
      "type": "object",
      "properties": {
        "payment_method": {
          "type": "string",
          "enum": ["cash", "loan", "lease", "ppa", "installment"],
          "description": "Payment method"
        },
        "financing_partner": {
          "type": "string",
          "description": "Financing partner name"
        },
        "loan_tenure_months": {
          "type": "integer",
          "description": "Loan tenure in months"
        },
        "interest_rate_annual": {
          "type": "number",
          "description": "Annual interest rate"
        },
        "monthly_installment_myr": {
          "type": "number",
          "description": "Monthly installment amount"
        },
        "down_payment_myr": {
          "type": "number",
          "description": "Down payment amount"
        },
        "down_payment_percentage": {
          "type": "number",
          "description": "Down payment as percentage"
        },
        "payment_schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "milestone": {
                "type": "string",
                "enum": [
                  "deposit",
                  "equipment_delivery",
                  "installation_start",
                  "installation_complete",
                  "commissioning",
                  "final"
                ],
                "description": "Payment milestone"
              },
              "percentage": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Percentage of total"
              },
              "amount_myr": {
                "type": "number",
                "description": "Payment amount"
              },
              "due_description": {
                "type": "string",
                "description": "When payment is due"
              }
            }
          },
          "description": "Payment schedule milestones"
        },
        "accepted_payment_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["bank_transfer", "cheque", "credit_card", "fpx", "cash", "ewallet"]
          },
          "description": "Accepted payment methods"
        },
        "bank_details": {
          "type": "object",
          "properties": {
            "bank_name": {
              "type": "string"
            },
            "account_name": {
              "type": "string"
            },
            "account_number": {
              "type": "string"
            }
          }
        }
      },
      "description": "Payment plan and financing details"
    },
    "quote_details": {
      "type": "object",
      "properties": {
        "quote_number": {
          "type": "string",
          "pattern": "^QT-[0-9]{4}-[0-9]{5}$",
          "description": "Unique quote reference number (e.g., QT-2025-00001)"
        },
        "quote_version": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Version number for revised quotes"
        },
        "quote_date": {
          "type": "string",
          "format": "date",
          "description": "Date of quotation"
        },
        "valid_until": {
          "type": "string",
          "format": "date",
          "description": "Quote validity expiry date"
        },
        "validity_days": {
          "type": "integer",
          "minimum": 7,
          "maximum": 90,
          "default": 30,
          "description": "Number of days quote is valid"
        },
        "currency": {
          "type": "string",
          "enum": ["MYR", "SGD", "USD"],
          "default": "MYR",
          "description": "Currency for pricing"
        }
      }
    },
    "system_configuration": {
      "type": "object",
      "properties": {
        "system_size_kwp": {
          "type": "number",
          "description": "Total system size in kWp"
        },
        "panel_specifications": {
          "type": "object",
          "properties": {
            "brand": {
              "type": "string",
              "description": "Panel manufacturer brand"
            },
            "model": {
              "type": "string",
              "description": "Panel model number"
            },
            "wattage": {
              "type": "integer",
              "description": "Panel wattage (W)"
            },
            "quantity": {
              "type": "integer",
              "description": "Number of panels"
            },
            "panel_type": {
              "type": "string",
              "enum": ["monocrystalline", "polycrystalline", "bifacial", "thin_film"],
              "description": "Panel technology type"
            },
            "efficiency_percentage": {
              "type": "number",
              "description": "Panel efficiency percentage"
            },
            "warranty_years": {
              "type": "integer",
              "description": "Panel product warranty years"
            },
            "performance_warranty_years": {
              "type": "integer",
              "description": "Performance warranty years"
            }
          }
        },
        "inverter_specifications": {
          "type": "object",
          "properties": {
            "brand": {
              "type": "string",
              "description": "Inverter manufacturer brand"
            },
            "model": {
              "type": "string",
              "description": "Inverter model number"
            },
            "type": {
              "type": "string",
              "enum": ["string", "micro", "hybrid", "central"],
              "description": "Inverter type"
            },
            "capacity_kw": {
              "type": "number",
              "description": "Inverter capacity (kW)"
            },
            "quantity": {
              "type": "integer",
              "description": "Number of inverters"
            },
            "warranty_years": {
              "type": "integer",
              "description": "Inverter warranty years"
            }
          }
        },
        "battery_specifications": {
          "type": "object",
          "properties": {
            "included": {
              "type": "boolean",
              "default": false,
              "description": "Whether battery is included"
            },
            "brand": {
              "type": "string",
              "description": "Battery manufacturer brand"
            },
            "model": {
              "type": "string",
              "description": "Battery model"
            },
            "capacity_kwh": {
              "type": "number",
              "description": "Battery capacity (kWh)"
            },
            "quantity": {
              "type": "integer",
              "description": "Number of battery units"
            },
            "warranty_years": {
              "type": "integer",
              "description": "Battery warranty years"
            }
          }
        },
        "mounting_system": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["roof_mount", "ground_mount", "carport", "floating"],
              "description": "Mounting system type"
            },
            "material": {
              "type": "string",
              "enum": ["aluminum", "galvanized_steel", "stainless_steel"],
              "description": "Mounting material"
            },
            "brand": {
              "type": "string",
              "description": "Mounting system brand"
            }
          }
        }
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "line_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_code": {
                "type": "string",
                "description": "Item SKU or code"
              },
              "description": {
                "type": "string",
                "description": "Item description"
              },
              "category": {
                "type": "string",
                "enum": ["equipment", "installation", "permit", "other"],
                "description": "Item category"
              },
              "quantity": {
                "type": "number",
                "description": "Quantity"
              },
              "unit": {
                "type": "string",
                "description": "Unit of measure"
              },
              "unit_price_myr": {
                "type": "number",
                "description": "Unit price"
              },
              "total_price_myr": {
                "type": "number",
                "description": "Line total"
              }
            }
          },
          "description": "Itemized pricing breakdown"
        },
        "subtotal_myr": {
          "type": "number",
          "description": "Subtotal before discounts and tax"
        },
        "total_discount_myr": {
          "type": "number",
          "description": "Total discount amount"
        },
        "tax": {
          "type": "object",
          "properties": {
            "sst_applicable": {
              "type": "boolean",
              "default": false,
              "description": "Whether SST applies"
            },
            "sst_rate": {
              "type": "number",
              "default": 0.06,
              "description": "SST rate"
            },
            "sst_amount_myr": {
              "type": "number",
              "description": "Calculated SST amount"
            }
          }
        },
        "total_amount_myr": {
          "type": "number",
          "description": "Total quote amount"
        },
        "price_per_kwp_myr": {
          "type": "number",
          "description": "Price per kWp for comparison"
        }
      }
    },
    "project_timeline": {
      "type": "object",
      "properties": {
        "estimated_start_date": {
          "type": "string",
          "format": "date",
          "description": "Estimated project start date"
        },
        "estimated_completion_days": {
          "type": "integer",
          "description": "Estimated days to completion"
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "milestone_name": {
                "type": "string"
              },
              "duration_days": {
                "type": "integer"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "description": "Project milestones"
        }
      }
    },
    "warranty_information": {
      "type": "object",
      "properties": {
        "workmanship_warranty_years": {
          "type": "integer",
          "default": 5,
          "description": "Workmanship warranty period"
        },
        "system_warranty_years": {
          "type": "integer",
          "default": 10,
          "description": "Overall system warranty"
        },
        "warranty_terms": {
          "type": "string",
          "description": "Detailed warranty terms"
        }
      }
    },
    "terms_and_conditions": {
      "type": "object",
      "properties": {
        "standard_terms_version": {
          "type": "string",
          "description": "Version of standard T&C applied"
        },
        "special_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Special conditions for this quote"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Items excluded from quote"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Assumptions made in quote"
        }
      }
    },
    "output_configuration": {
      "type": "object",
      "properties": {
        "output_formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["pdf", "docx", "pptx", "xlsx"]
          },
          "default": ["pdf"],
          "description": "Output document formats"
        },
        "template_id": {
          "type": "string",
          "default": "standard",
          "description": "Template to use for generation"
        },
        "include_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cover_page",
              "executive_summary",
              "company_profile",
              "system_overview",
              "technical_specs",
              "roi_analysis",
              "pricing_breakdown",
              "payment_schedule",
              "project_timeline",
              "warranty_info",
              "terms_conditions",
              "appendix"
            ]
          },
          "description": "Sections to include in document"
        },
        "branding": {
          "type": "object",
          "properties": {
            "logo_url": {
              "type": "string",
              "format": "uri"
            },
            "primary_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "secondary_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "company_name": {
              "type": "string"
            },
            "company_address": {
              "type": "string"
            },
            "company_phone": {
              "type": "string"
            },
            "company_email": {
              "type": "string"
            },
            "company_website": {
              "type": "string"
            }
          }
        },
        "language": {
          "type": "string",
          "enum": ["en", "ms", "zh"],
          "default": "en",
          "description": "Document language"
        }
      }
    },
    "generated_documents": {
      "type": "object",
      "properties": {
        "pdf": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "generated_at": {
              "type": "string",
              "format": "date-time"
            },
            "file_size_bytes": {
              "type": "integer"
            }
          }
        },
        "docx": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "generated_at": {
              "type": "string",
              "format": "date-time"
            },
            "file_size_bytes": {
              "type": "integer"
            }
          }
        },
        "pptx": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "generated_at": {
              "type": "string",
              "format": "date-time"
            },
            "file_size_bytes": {
              "type": "integer"
            }
          }
        },
        "xlsx": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "generated_at": {
              "type": "string",
              "format": "date-time"
            },
            "file_size_bytes": {
              "type": "integer"
            }
          }
        }
      },
      "description": "Generated document URLs"
    },
    "quotation_status": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "pending_approval",
            "approved",
            "sent",
            "viewed",
            "accepted",
            "rejected",
            "expired",
            "superseded"
          ],
          "default": "draft",
          "description": "Current quotation status"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time",
          "description": "When quote was sent to customer"
        },
        "viewed_at": {
          "type": "string",
          "format": "date-time",
          "description": "When customer viewed quote"
        },
        "response_at": {
          "type": "string",
          "format": "date-time",
          "description": "When customer responded"
        },
        "response_notes": {
          "type": "string",
          "description": "Customer feedback or response notes"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "format": "uuid"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer"
              },
              "changed_at": {
                "type": "string",
                "format": "date-time"
              },
              "changed_by": {
                "type": "string",
                "format": "uuid"
              },
              "change_summary": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
