{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["brand_name"],
  "properties": {
    "brand_name": {
      "type": "string",
      "minLength": 2,
      "description": "Brand name"
    },
    "prd": {
      "type": "object",
      "description": "PRD output from prd.generate.v1",
      "properties": {
        "feature_list": {
          "type": "object",
          "properties": {
            "mvp": {"type": "array", "items": {"type": "string"}},
            "phase_2": {"type": "array", "items": {"type": "string"}},
            "future": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "pricing": {
      "type": "object",
      "description": "Pricing output from pricing.generate.v1"
    },
    "target_launch_date": {
      "type": "string",
      "description": "Target launch date (ISO 8601 or human-readable)"
    }
  }
}
